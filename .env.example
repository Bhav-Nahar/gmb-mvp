# Application environment: "development" or "production".
# Defaults to "production" in code if unset (fail-closed). The local
# docker-compose.yml sets this to development for you.
APP_ENV=development

# Database Configuration
# Change POSTGRES_PASSWORD to a strong value before any non-local deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gmb_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/gmb_db

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0

# Security Configuration
# REQUIRED. Generate a unique secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# REQUIRED. 32 url-safe base64-encoded bytes, e.g.:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# REQUIRED. Secret used to trigger on-demand Next.js ISR revalidation from the backend.
REVALIDATE_SECRET=

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# LLM Configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Platform super-admins (comma-separated emails). These accounts unlock the
# cross-org /admin control panel after a normal Google login. Leave empty to
# disable. Example: SUPERADMIN_EMAILS=you@company.com,ops@company.com
SUPERADMIN_EMAILS=

# Shared cookie domain. Set ONLY in production when the frontend and API are on
# sibling subdomains of one registrable domain (e.g. app.pinzo.io + api.pinzo.io).
# Use the parent WITH a leading dot so auth cookies work across both hosts and
# survive browsers that block third-party cookies. Leave EMPTY for localhost dev.
#   COOKIE_DOMAIN=.pinzo.io
COOKIE_DOMAIN=

# Razorpay Configuration
RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Server-side ad conversions (fired from the Razorpay webhook). All optional —
# each integration stays inert until its credentials are filled in.
# Meta Conversions API (Events Manager → Settings → Conversions API)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_API_VERSION=v21.0
# Google Ads offline click-conversion upload (Google Ads API + OAuth)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=          # digits only, no dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # optional, for manager (MCC) accounts
GOOGLE_ADS_CONVERSION_ACTION_ID=

# DataForSEO — local rank grid heatmap + competitor maps data.
# Free to start: sign up at https://app.dataforseo.com → Dashboard → API Access,
# then copy your API login + API password (NOT your account password; the API
# password is shown only for the first 24h after signup). You get a free Sandbox
# plus a $1 live credit, no card required.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Defaults to the FREE sandbox (simulated data). Set to https://api.dataforseo.com
# for real ranks (~$0.0006 per grid point).
DATAFORSEO_BASE_URL=https://sandbox.dataforseo.com

# Resend Email Service Configuration
# Set to your Resend API key. If left blank, lead emails will be silently skipped.
RESEND_API_KEY=

{
    "event": "promoClick",
    "promoClick": {
        "creative_name": "homepage banner images clicked",
        "location_id": "homepage",
        "promo_id": "9KT Collection Banner Image",
        "promo_name": "9KT Collection"
    },
    "gtm.uniqueEventId": 67
}


{
  "event": "sign_up_start",
  "user":{
  	"event_id": "evt_3f2a9c1e-7b44-4d2a-9f10-8e6b2c4d1a55",
  	"lead_magnet": "7_day_trial",
  	"cta_location": "hero",
  	"page_path": "/login/success"
	}
}

# ── WhatsApp review collection (Meta Cloud API) ──────────────────────────────
# Pinzo is a Meta Tech Provider: in production each ORGANIZATION connects its
# own WhatsApp Business Account via Embedded Signup, and those credentials are
# stored per-org (encrypted) in the whatsapp_accounts table — NOT here.
#
# The three values below are the DEVELOPMENT test WABA only. They exist so the
# send pipeline can be exercised end-to-end before Meta grants advanced access.
# Leave them empty in production.
WHATSAPP_SYSTEM_TOKEN=
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_WABA_ID=

# Meta app identifiers for Embedded Signup (Tech Provider). These identify
# PINZO's app; each client's own WABA token is stored per-organization,
# encrypted, in the whatsapp_accounts table.
#   FACEBOOK_APP_ID / SECRET   App Dashboard -> Settings -> Basic
#   WHATSAPP_ES_CONFIG_ID      the "Facebook Login for Business" configuration
#                              (login variation: WhatsApp Embedded Signup, with
#                              whatsapp_business_management + _messaging)
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN  any long random string; paste the SAME value
#                              into the webhook config in the Meta dashboard
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
WHATSAPP_ES_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Embedded Signup only ever redirects to a public HTTPS URL, so FRONTEND_URL
# (above) must be the PUBLIC base while testing the connect flow — an ngrok /
# Cloudflare tunnel locally, or https://pinzo.io in production. Whatever it is,
# register <FRONTEND_URL>/whatsapp/callback under the app's Redirect URI
# settings, character for character including the trailing path. A mismatch
# fails the code exchange with an error that does not say which side is wrong.

# Graph API version. Pinned, because a template or number payload that is valid
# on one version can be rejected on the next.
WHATSAPP_GRAPH_VERSION=v21.0

# Hours before the same customer may be asked for a review again.
# 24 is for testing. Production should be 720 (30 days) or more.
REVIEW_REQUEST_COOLDOWN_HOURS=24

# Base URL baked into the review template button. Must be the PRODUCTION host
# even in dev — an approved template URL can never be changed.
REVIEW_LINK_BASE_URL=https://pinzo.io

# Meta App Review reviewer login. Turn OFF once the review completes.
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD_HASH=

# Shows the email/password form on /login (Meta App Review reviewer only).
NEXT_PUBLIC_DEMO_LOGIN=false
