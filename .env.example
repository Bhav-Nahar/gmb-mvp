# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gmb_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/gmb_db

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0

# Security Configuration
JWT_SECRET=supersecretjwtkeyplaceholderchangeinproduction
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 32 url-safe base64-encoded bytes (can generate using cryptography.fernet.Fernet.generate_key())
ENCRYPTION_KEY=dGhpcyBpcyBhIDMyIGJ5dGUga2V5IGZvciBhZXMgZW5jcnlwdGlvbg==

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# LLM Configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Frontend URL
# Frontend URL
FRONTEND_URL=http://localhost:3000

# Razorpay Configuration
RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
