# Application environment: "development" or "production".
# Defaults to "production" in code if unset (fail-closed). The local
# docker-compose.yml sets this to development for you.
APP_ENV=development

# Database Configuration
# Change POSTGRES_PASSWORD to a strong value before any non-local deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gmb_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/gmb_db

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0

# Security Configuration
# REQUIRED. Generate a unique secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# REQUIRED. 32 url-safe base64-encoded bytes, e.g.:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# REQUIRED. Secret used to trigger on-demand Next.js ISR revalidation from the backend.
REVALIDATE_SECRET=

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# LLM Configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Platform super-admins (comma-separated emails). These accounts unlock the
# cross-org /admin control panel after a normal Google login. Leave empty to
# disable. Example: SUPERADMIN_EMAILS=you@company.com,ops@company.com
SUPERADMIN_EMAILS=

# Shared cookie domain. Set ONLY in production when the frontend and API are on
# sibling subdomains of one registrable domain (e.g. app.pinzo.io + api.pinzo.io).
# Use the parent WITH a leading dot so auth cookies work across both hosts and
# survive browsers that block third-party cookies. Leave EMPTY for localhost dev.
#   COOKIE_DOMAIN=.pinzo.io
COOKIE_DOMAIN=

# Razorpay Configuration
RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# DataForSEO — local rank grid heatmap + competitor maps data.
# Free to start: sign up at https://app.dataforseo.com → Dashboard → API Access,
# then copy your API login + API password (NOT your account password; the API
# password is shown only for the first 24h after signup). You get a free Sandbox
# plus a $1 live credit, no card required.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Defaults to the FREE sandbox (simulated data). Set to https://api.dataforseo.com
# for real ranks (~$0.0006 per grid point).
DATAFORSEO_BASE_URL=https://sandbox.dataforseo.com
